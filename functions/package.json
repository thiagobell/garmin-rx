{
  "name": "health-dashboard-functions",
  "version": "1.0.0",
  "description": "Cloud Functions (2nd Gen) & Firestore Data Pipeline for Health Dashboard",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "seed": "npx tsx src/seedFirestore.ts",
    "seed:dry-run": "npx tsx src/seedFirestore.ts --dry-run"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "private": true
}
