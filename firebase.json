{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "bun run --cwd functions build"
      ]
    }
  ],
  "hosting": {
    "predeploy": "bun run --cwd web build",
    "public": "web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/quick",
        "destination": "/quick.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
